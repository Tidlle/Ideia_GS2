{
  "expo": {
    "name": "Zela",
    "slug": "zela",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "scheme": "zela",
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Zela usa suas fotos para anexar ao reporte.",
          "cameraPermission": "O Zela usa a câmera para fotografar o problema."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Zela usa sua localização para registrar o problema e conferir o check-in."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
